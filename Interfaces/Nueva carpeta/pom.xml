<?xml version="1.0" encoding="UTF-8"?>
<!--
    POM AGREGADOR: compila y testea todos los proyectos de Interfaces de una vez.
      mvn clean verify
    Cada proyecto sigue siendo independiente (se puede abrir/ejecutar solo).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>es.ciudadescolar</groupId>
    <artifactId>interfaces-todos</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>ejercicio1/ejercicio1</module>
        <module>Practica-2/practica2</module>
        <module>practica-3/practica3</module>
        <module>practica-3/practica3_1</module>
        <module>practica-3/PruebaBotonAccion</module>
        <module>tema3</module>
        <module>tema3-2</module>
        <module>examen</module>
    </modules>

    <!--
        Plugin JavaFX declarado aquí (desactivado en el agregador) para que
        "mvn javafx:run" funcione también desde esta carpeta:
          mvn clean javafx:run -pl examen     (ejecuta solo un proyecto)
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <inherited>false</inherited>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
