<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================== PERMISOS ===================== -->
    <!-- Normal: se concede al instalar -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Peligroso: además hay que pedirlo en tiempo de ejecución -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- La app no exige que el móvil tenga teléfono (si no, no se instala en tablets) -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Android 11+: para poder abrir apps de otros con intents implícitos -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EjemploTodo"
        tools:targetApi="31">

        <!-- Activity principal: LAUNCHER = icono en el móvil. exported=true obligatorio con intent-filter -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SEGUNDO índice: cada tema es su propio Box. También LAUNCHER = segundo icono en el móvil -->
        <activity
            android:name=".MainBoxActivity"
            android:exported="true"
            android:label="EjemploTodo Box">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ===== TODAS las Activity tienen que estar aquí ===== -->
        <activity android:name=".CicloVidaActivity" android:exported="false" />
        <activity android:name=".LayoutsActivity" android:exported="false" />
        <activity android:name=".EstadoActivity" android:exported="false" />
        <activity android:name=".IntentsExplicitosActivity" android:exported="false" />
        <activity android:name=".DestinoActivity" android:exported="false" />
        <activity android:name=".IntentsImplicitosActivity" android:exported="false" />
        <activity android:name=".VistasXmlActivity" android:exported="false" />
        <activity android:name=".ComposeAvanzadoActivity" android:exported="false" />

        <!-- Activity "clásicas" (android.app.Activity + Toolbar): tema del framework -->
        <activity android:name=".ListViewSimpleActivity" android:exported="false" android:theme="@style/Theme.EjemploTodo.Clasico" />
        <activity android:name=".ListViewPersonalizadoActivity" android:exported="false" android:theme="@style/Theme.EjemploTodo.Clasico" />
        <activity android:name=".GridViewActivity" android:exported="false" android:theme="@style/Theme.EjemploTodo.Clasico" />
        <activity android:name=".MenuOpcionesActivity" android:exported="false" android:theme="@style/Theme.EjemploTodo.Clasico" />
        <activity android:name=".MenuContextualActivity" android:exported="false" android:theme="@style/Theme.EjemploTodo.Clasico" />
    </application>

</manifest>
