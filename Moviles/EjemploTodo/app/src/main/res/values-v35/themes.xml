<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15+ (API 35) obliga a pantalla completa (edge-to-edge) y el contenido
         se mete debajo de la barra de estado. Con esto la app se ve igual que en clase. -->
    <style name="Theme.EjemploTodo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
    <style name="Theme.EjemploTodo.Clasico" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
